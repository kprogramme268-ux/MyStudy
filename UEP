function AnalyticsView({ course, questions, progressData, onStartPractice }) {
  const courseQuestions = questions.filter(q => q.courseCode === course.code);
  const attemptedIds = Object.keys(progressData.attempted || {});
  const correctCount = attemptedIds.filter(id => progressData.attempted[id]?.correct).length;
  const incorrectCount = attemptedIds.filter(id => progressData.attempted[id]?.correct === false).length;
  const accuracy = attemptedIds.length > 0 ? Math.round((correctCount / attemptedIds.length) * 100) : 0;

  return (
    <div className="max-w-5xl mx-auto space-y-6">
      <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
          <span className="text-[11px] font-extrabold uppercase text-slate-400">Số câu đã làm</span>
          <div className="text-2xl font-black text-slate-900 mt-1">{attemptedIds.length} / {courseQuestions.length}</div>
          <p className="text-xs text-emerald-700 font-bold mt-1">Đúng {correctCount} câu • Cần ôn lại {incorrectCount} câu</p>
        </div>
        <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
          <span className="text-[11px] font-extrabold uppercase text-slate-400">Độ chính xác (Accuracy)</span>
          <div className="text-2xl font-black text-emerald-600 mt-1">{accuracy}%</div>
          <p className="text-xs text-slate-500 font-semibold mt-1">Mục tiêu hiện tại: {course.targetGrade}</p>
        </div>
        <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
          <span className="text-[11px] font-extrabold uppercase text-slate-400">Mức độ sẵn sàng thi</span>
          <div className="text-2xl font-black text-slate-900 mt-1">
            {accuracy >= 80 ? 'Well Prepared' : accuracy >= 50 ? 'In Progress' : 'Building Base'}
          </div>
          <p className="text-xs text-slate-500 font-semibold mt-1">Dựa trên kết quả thực hành</p>
        </div>
      </div>

      <div className="bg-white rounded-2xl border border-slate-200 p-5 md:p-6 shadow-sm space-y-4">
        <h3 className="text-base font-extrabold text-slate-900">Chi tiết độ phủ theo từng Session</h3>
        <div className="space-y-3">
          {(course.sessions || []).map(s => {
            const sQs = courseQuestions.filter(q => q.sessionId === s.id);
            const sCorrect = sQs.filter(q => progressData.attempted?.[q.id]?.correct).length;
            const pct = sQs.length > 0 ? Math.round((sCorrect / sQs.length) * 100) : 0;
            return (
              <div key={s.id} className="p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div className="space-y-1 flex-1">
                  <div className="flex justify-between text-xs font-bold">
                    <span className="text-slate-900">{s.title}</span>
                    <span className="text-emerald-700">{pct}% ({sCorrect}/{sQs.length})</span>
                  </div>
                  <div className="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                    <div className="bg-emerald-600 h-full rounded-full" style={{ width: `${pct}%` }} />
                  </div>
                </div>
                <button
                  onClick={() => onStartPractice(s.id)}
                  className="px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:border-emerald-500 text-xs font-bold text-slate-700 shrink-0"
                >
                  Ôn phần này
                </button>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}

