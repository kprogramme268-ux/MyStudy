// 6. AI STUDY ASSISTANT (Bilingual Context-Aware Tutor)
// ============================================================================
function AiAssistantView({ course }) {
  const [messages, setMessages] = useState([
    {
      role: 'model',
      text: `Chào bạn! Mình là Trợ lý AI môn ${course.name}. Mình đã nắm rõ toàn bộ 12 Sessions từ sổ tay "Ôn tập itMarketing" của bạn (từ Marketing Myopia, MIE, Ethnographic Research cho đến Segmented Pricing và Disintermediation). Bạn muốn mình tóm tắt nhanh Session nào hay giải thích câu hỏi nào?`
    }
  ]);
  const [input, setInput] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  const scrollRef = useRef(null);

  useEffect(() => {
    if (scrollRef.current) scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
  }, [messages]);

  const generateSmartFallback = (query) => {
    const q = query.toLowerCase();
    if (q.includes('disintermediation') || q.includes('trung gian') || q.includes('channel')) {
      return 'Trong **Session 10 (Marketing Channels)**:\n- **Disintermediation (Loại bỏ trung gian):** Là việc nhà sản xuất cắt bỏ trung gian truyền thống hoặc thay thế bằng nền tảng mới (VD: Airbnb thay thế khách sạn truyền thống, Lyft thay thế hãng taxi).\n- **Horizontal Marketing System:** 2 công ty cùng cấp hợp tác (VD: Best Buy và Amazon mở quầy Alexa ngay trong Best Buy).';
    }
    if (q.includes('price') || q.includes('pricing') || q.includes('giá')) {
      return 'Trong **Session 9 (Pricing Strategies)**:\n- **Price** là yếu tố duy nhất trong Marketing Mix tạo ra **doanh thu (revenue)**, các yếu tố khác đều là chi phí.\n- **Segmented Pricing (Định giá phân khúc):** Bán 2 hay nhiều mức giá khác nhau dù chi phí không đổi (theo Customer-segment, Product form, Location-based, Time-based).';
    }
    if (q.includes('myopia') || q.includes('session 1')) {
      return 'Trong **Session 1 & Đề Quiz #1 VNUK**:\n- **Marketing Myopia (Thiển cận marketing):** Quá tập trung vào sản phẩm cụ thể (specific products) mà quên mất lợi ích và trải nghiệm (benefits & experiences) mà khách hàng thực sự cần.\n- **Bước 1 của quy trình 5 bước Marketing:** Understand the marketplace and customer needs and wants.';
    }
    return `Về câu hỏi "${query}" trong môn **${course.name}**: Bạn hãy chú ý nắm chắc thuật ngữ tiếng Anh (Keyword) và liên hệ với ví dụ thực tế trong slide Pearson (như Intuit follow-me-home cho Ethnographic research ở Session 5, hoặc 3 cấp độ sản phẩm Core - Actual - Augmented ở Session 7&8). Bạn muốn mình tạo thêm câu hỏi trắc nghiệm cho phần này không?`;
  };

  const handleSend = async (customPrompt) => {
    const textToSend = customPrompt || input;
    if (!textToSend.trim()) return;
    if (!customPrompt) setInput('');
    setMessages(prev => [...prev, { role: 'user', text: textToSend }]);
    setIsTyping(true);

    try {
      const payload = {
        contents: [{ role: 'user', parts: [{ text: `Course: ${course.name}. Question: ${textToSend}` }] }],
        systemInstruction: { parts: [{ text: "You are an academic tutor for Introduction to Marketing (Pearson Kotler & Armstrong). Keep English marketing keywords intact and explain clearly in Vietnamese." }] }
      };
      const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (response.ok) {
        const data = await response.json();
        const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || generateSmartFallback(textToSend);
        setMessages(prev => [...prev, { role: 'model', text: reply }]);
      } else {
        setMessages(prev => [...prev, { role: 'model', text: generateSmartFallback(textToSend) }]);
      }
    } catch {
      setMessages(prev => [...prev, { role: 'model', text: generateSmartFallback(textToSend) }]);
    } finally {
      setIsTyping(false);
    }
  };

  return (
    <div className="max-w-4xl mx-auto h-[calc(100vh-140px)] flex flex-col bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div className="bg-emerald-900 text-white p-4 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <Bot className="text-emerald-300" />
          <div>
            <h3 className="font-extrabold text-sm">AI Study Assistant — Ôn tập itMarketing</h3>
            <p className="text-[11px] text-emerald-200">Giữ nguyên Keyword tiếng Anh • Giải thích tiếng Việt dễ nhớ</p>
          </div>
        </div>
      </div>

      {/* Quick Prompts */}
      <div className="px-4 py-2.5 bg-emerald-50 border-b border-emerald-100 flex flex-wrap gap-2">
        <button onClick={() => handleSend('Tóm tắt trọng tâm Session 9 (Pricing Strategies)')} className="text-[11px] font-bold bg-white text-emerald-800 border border-emerald-200 px-2.5 py-1 rounded-lg hover:bg-emerald-100">
          Tóm tắt Session 9 (Pricing)
        </button>
        <button onClick={() => handleSend('Giải thích Disintermediation và Horizontal System ở Session 10')} className="text-[11px] font-bold bg-white text-emerald-800 border border-emerald-200 px-2.5 py-1 rounded-lg hover:bg-emerald-100">
          Giải thích Session 10 (Channels)
        </button>
        <button onClick={() => handleSend('Giải thích Marketing Myopia trong đề Quiz #1 VNUK')} className="text-[11px] font-bold bg-white text-emerald-800 border border-emerald-200 px-2.5 py-1 rounded-lg hover:bg-emerald-100">
          Giải thích Marketing Myopia
        </button>
      </div>

      <div ref={scrollRef} className="flex-1 overflow-y-auto p-4 md:p-6 space-y-4 bg-slate-50">
        {messages.map((m, i) => (
          <div key={i} className={`flex ${m.role === 'user' ? 'justify-end' : 'justify-start'}`}>
            <div className={`max-w-[85%] p-4 rounded-2xl text-xs md:text-sm whitespace-pre-line leading-relaxed font-medium ${
              m.role === 'user' ? 'bg-emerald-600 text-white rounded-tr-sm' : 'bg-white border border-slate-200 text-slate-800 rounded-tl-sm shadow-sm'
            }`}>
              {m.text}
            </div>
          </div>
        ))}
        {isTyping && <div className="text-xs font-bold text-slate-400 animate-pulse">AI đang phân tích bài giảng...</div>}
      </div>

      <div className="p-3.5 border-t border-slate-200 bg-white flex gap-2">
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyDown={(e) => e.key === 'Enter' && handleSend()}
          placeholder="Hỏi bất kỳ khái niệm nào (VD: Segmented pricing là gì?)..."
          className="flex-1 bg-slate-100 rounded-xl px-4 py-2.5 text-xs md:text-sm font-medium outline-none focus:ring-2 focus:ring-emerald-500"
        />
        <button
          onClick={() => handleSend()}
          disabled={isTyping}
          className="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl font-bold flex items-center justify-center"
        >
          <Send size={16} />
        </button>
      </div>
    </div>
  );
}

