function QuizEngineView({ course, questions, sessionFilter, setSessionFilter, progressData, updateProgress }) {
  const [quizMode, setQuizMode] = useState('fresh'); // 'fresh' (unseen/unmastered) or 'all' (review all)
  const [currentIdx, setCurrentIdx] = useState(0);
  const [selectedOption, setSelectedOption] = useState(null);
  const [isSubmitted, setIsSubmitted] = useState(false);

  const courseQuestions = questions.filter(q => {
    const matchCourse = q.courseCode === course.code;
    const matchSession = sessionFilter === 'ALL' || q.sessionId === sessionFilter;
    if (!matchCourse || !matchSession) return false;
    if (quizMode === 'fresh') {
      return !(progressData.attempted?.[q.id]?.correct === true);
    }
    return true;
  });

  const currentQ = courseQuestions[currentIdx] || courseQuestions[0];

  const handleSelectOption = (idx) => {
    if (isSubmitted) return;
    setSelectedOption(idx);
  };

  const handleSubmitAnswer = () => {
    if (selectedOption === null || !currentQ) return;
    setIsSubmitted(true);
    const isCorrect = selectedOption === currentQ.correctIndex;

    const updatedAttempted = {
      ...(progressData.attempted || {}),
      [currentQ.id]: {
        correct: isCorrect,
        selected: selectedOption,
        timestamp: Date.now()
      }
    };

    updateProgress({
      attempted: updatedAttempted,
      xp: (progressData.xp || 350) + (isCorrect ? 25 : 5)
    });
  };

  const handleNextQuestion = () => {
    setSelectedOption(null);
    setIsSubmitted(false);
    if (currentIdx < courseQuestions.length - 1) {
      setCurrentIdx(currentIdx + 1);
    } else {
      setCurrentIdx(0);
    }
  };

  const handlePrevQuestion = () => {
    setSelectedOption(null);
    setIsSubmitted(false);
    if (currentIdx > 0) {
      setCurrentIdx(currentIdx - 1);
    }
  };

  const handleResetProgress = () => {
    updateProgress({ attempted: {} });
    setCurrentIdx(0);
    setSelectedOption(null);
    setIsSubmitted(false);
  };

  return (
    <div className="max-w-3xl mx-auto space-y-5">
      {/* Filter & Mode Header */}
      <div className="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div className="flex flex-wrap items-center gap-2">
          <select
            value={sessionFilter}
            onChange={(e) => { setSessionFilter(e.target.value); setCurrentIdx(0); setSelectedOption(null); setIsSubmitted(false); }}
            className="bg-slate-100 border border-slate-200 rounded-xl px-3 py-2 text-xs font-extrabold text-slate-800 outline-none"
          >
            <option value="ALL">Tất cả Sessions (1 - 12)</option>
            {(course.sessions || []).map(s => (
              <option key={s.id} value={s.id}>{s.title}</option>
            ))}
          </select>

          <div className="inline-flex rounded-xl bg-slate-100 p-1">
            <button
              onClick={() => { setQuizMode('fresh'); setCurrentIdx(0); setSelectedOption(null); setIsSubmitted(false); }}
              className={`px-3 py-1 rounded-lg text-xs font-bold transition ${quizMode === 'fresh' ? 'bg-emerald-600 text-white' : 'text-slate-600'}`}
            >
              Câu mới ({questions.filter(q => q.courseCode === course.code && !(progressData.attempted?.[q.id]?.correct)).length})
            </button>
            <button
              onClick={() => { setQuizMode('all'); setCurrentIdx(0); setSelectedOption(null); setIsSubmitted(false); }}
              className={`px-3 py-1 rounded-lg text-xs font-bold transition ${quizMode === 'all' ? 'bg-emerald-600 text-white' : 'text-slate-600'}`}
            >
              Ôn lại tất cả ({questions.filter(q => q.courseCode === course.code).length})
            </button>
          </div>
        </div>

        <button
          onClick={handleResetProgress}
          className="text-xs font-bold text-slate-500 hover:text-emerald-700 flex items-center gap-1"
        >
          <RefreshCw size={13} /> Làm mới lịch sử câu hỏi
        </button>
      </div>

      {/* Empty State when all Fresh questions are mastered */}
      {!currentQ ? (
        <div className="bg-white rounded-2xl border border-slate-200 p-8 text-center space-y-4 shadow-sm">
          <div className="w-14 h-14 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto">
            <Award size={30} />
          </div>
          <h3 className="text-xl font-extrabold text-slate-900">Tuyệt vời! Bạn đã hoàn thành toàn bộ câu hỏi mới!</h3>
          <p className="text-xs text-slate-500 max-w-md mx-auto">
            Hệ thống Non-Repetition Engine đã ẩn các câu bạn trả lời đúng để tránh lặp lại nhàm chán. Bạn có thể chuyển sang chế độ Ôn lại tất cả hoặc làm mới lịch sử.
          </p>
          <div className="flex justify-center gap-3">
            <button
              onClick={() => setQuizMode('all')}
              className="bg-emerald-600 text-white px-5 py-2.5 rounded-xl text-xs font-extrabold"
            >
              Chuyển sang chế độ Ôn tập lại
            </button>
            <button
              onClick={handleResetProgress}
              className="bg-slate-100 text-slate-700 px-5 py-2.5 rounded-xl text-xs font-extrabold"
            >
              Reset làm lại từ đầu
            </button>
          </div>
        </div>
      ) : (
        <div className="bg-white rounded-2xl border-2 border-emerald-500 p-5 md:p-8 shadow-md space-y-6">
          {/* Context Metadata */}
          <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
            <div className="flex flex-wrap items-center gap-2">
              <span className="bg-emerald-100 text-emerald-800 text-[11px] font-extrabold px-2.5 py-1 rounded-md">
                {currentQ.sessionTitle}
              </span>
              <span className="bg-slate-100 text-slate-600 text-[11px] font-bold px-2.5 py-1 rounded-md">
                {currentQ.origin}
              </span>
            </div>
            <span className="text-xs font-extrabold text-slate-500">
              Câu {currentIdx + 1} / {courseQuestions.length}
            </span>
          </div>

          {/* English Question Prompt */}
          <div>
            <h2 className="text-base md:text-lg font-extrabold text-slate-900 leading-relaxed">
              {currentQ.question}
            </h2>
            <p className="text-[11px] font-semibold text-slate-400 mt-1">
              Nguồn trích xuất: {currentQ.sourceDoc}
            </p>
          </div>

          {/* Answer Options */}
          <div className="space-y-2.5">
            {currentQ.options.map((opt, idx) => {
              let optionStyle = 'border-slate-200 hover:border-emerald-400 bg-white text-slate-800';
              if (selectedOption === idx) {
                optionStyle = 'border-emerald-600 bg-emerald-50 text-emerald-950 font-bold ring-2 ring-emerald-100';
              }
              if (isSubmitted) {
                if (idx === currentQ.correctIndex) {
                  optionStyle = 'border-emerald-600 bg-emerald-100 text-emerald-950 font-extrabold';
                } else if (idx === selectedOption && idx !== currentQ.correctIndex) {
                  optionStyle = 'border-red-400 bg-red-50 text-red-900 line-through';
                } else {
                  optionStyle = 'border-slate-200 bg-slate-50 text-slate-400 opacity-70';
                }
              }

              return (
                <button
                  key={idx}
                  type="button"
                  disabled={isSubmitted}
                  onClick={() => handleSelectOption(idx)}
                  className={`w-full text-left p-3.5 md:p-4 rounded-xl border-2 text-xs md:text-sm transition-all flex items-center justify-between gap-3 ${optionStyle}`}
                >
                  <span><strong className="mr-2">{String.fromCharCode(65 + idx)}.</strong> {opt}</span>
                  {isSubmitted && idx === currentQ.correctIndex && <CheckCircle2 size={18} className="text-emerald-600 shrink-0" />}
                </button>
              );
            })}
          </div>

          {/* Immediate Vietnamese Explanation */}
          {isSubmitted && (
            <div className={`p-4 md:p-5 rounded-xl border-2 ${selectedOption === currentQ.correctIndex ? 'bg-emerald-50/80 border-emerald-200' : 'bg-amber-50/80 border-amber-200'}`}>
              <div className="flex items-center gap-2 mb-1.5">
                {selectedOption === currentQ.correctIndex ? (
                  <CheckCircle2 size={18} className="text-emerald-600" />
                ) : (
                  <AlertCircle size={18} className="text-amber-600" />
                )}
                <h4 className={`text-xs md:text-sm font-extrabold ${selectedOption === currentQ.correctIndex ? 'text-emerald-900' : 'text-amber-900'}`}>
                  {selectedOption === currentQ.correctIndex ? 'Chính xác! (+25 XP)' : 'Cần lưu ý! (+5 XP học tập)'}
                </h4>
              </div>
              <p className="text-xs md:text-sm text-slate-800 leading-relaxed font-medium">
                {currentQ.explanationVi}
              </p>
            </div>
          )}

          {/* Bottom Navigation Bar */}
          <div className="pt-2 flex items-center justify-between gap-3">
            <button
              type="button"
              onClick={handlePrevQuestion}
              disabled={currentIdx === 0}
              className="px-4 py-2.5 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50 disabled:opacity-40 flex items-center gap-1"
            >
              <ChevronLeft size={16} /> Câu trước
            </button>

            {!isSubmitted ? (
              <button
                type="button"
                onClick={handleSubmitAnswer}
                disabled={selectedOption === null}
                className="bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-300 text-white px-6 py-2.5 rounded-xl text-xs md:text-sm font-extrabold shadow-sm transition"
              >
                Kiểm tra đáp án
              </button>
            ) : (
              <button
                type="button"
                onClick={handleNextQuestion}
                className="bg-slate-900 hover:bg-emerald-700 text-white px-6 py-2.5 rounded-xl text-xs md:text-sm font-extrabold shadow-sm flex items-center gap-1.5 transition"
              >
                Câu tiếp theo <ArrowRight size={16} />
              </button>
            )}
          </div>
        </div>
      )}
    </div>
  );
}

