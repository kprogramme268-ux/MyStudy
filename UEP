// ============================================================================
// MAIN APPLICATION COMPONENT
// ============================================================================
export default function EdTechApp() {
  const [user, setUser] = useState(null);
  const [courses, setCourses] = useState([DEFAULT_MARKETING_COURSE]);
  const [activeCourseId, setActiveCourseId] = useState(DEFAULT_MARKETING_COURSE.id);
  const [questions, setQuestions] = useState(INITIAL_QUESTIONS);
  const [progressData, setProgressData] = useState({
    attempted: {},
    flagged: {},
    xp: 350,
    streak: 4,
    completedDays: [1]
  });
  
  const [currentView, setCurrentView] = useState('roadmap'); // 'roadmap', 'documents', 'theory', 'quiz', 'analytics', 'ai', 'dashboard', 'course_form'
  const [selectedSessionFilter, setSelectedSessionFilter] = useState('ALL');
  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);

  // --- Auth & Persistence ---
  useEffect(() => {
    const savedProgress = localStorage.getItem('uni_exam_prep_progress_v2');
    if (savedProgress) {
      try {
        setProgressData(JSON.parse(savedProgress));
      } catch (e) {
        console.error(e);
      }
    }

    if (!auth) return;
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        console.error('Auth error:', err);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, (currentUser) => {
      setUser(currentUser);
    });
    return () => unsubscribe();
  }, []);

  const updateProgress = (newProgress) => {
    setProgressData(prev => {
      const updated = { ...prev, ...newProgress };
      localStorage.setItem('uni_exam_prep_progress_v2', JSON.stringify(updated));
      return updated;
    });
  };

  const activeCourse = courses.find(c => c.id === activeCourseId) || courses[0];

  const handleNavigate = (view, sessionFilter = 'ALL') => {
    setSelectedSessionFilter(sessionFilter);
    setCurrentView(view);
    setIsMobileMenuOpen(false);
  };

  return (
    <div className="flex flex-col md:flex-row h-screen w-full bg-slate-50 text-slate-800 font-sans overflow-hidden">
      
      {/* MOBILE TOP BAR */}
      <div className="md:hidden bg-emerald-800 text-white px-4 py-3 flex items-center justify-between shadow-md z-30 shrink-0">
        <div className="flex items-center gap-2.5">
          <div className="bg-white/15 p-1.5 rounded-lg">
            <GraduationCap size={20} />
          </div>
          <div>
            <h1 className="font-extrabold text-sm leading-none">University Exam Prep</h1>
            <p className="text-[10px] text-emerald-200 font-medium mt-0.5 truncate max-w-[180px]">{activeCourse?.name}</p>
          </div>
        </div>
        <div className="flex items-center gap-3">
          <span className="bg-emerald-900/80 px-2.5 py-1 rounded-full text-[11px] font-bold flex items-center gap-1 text-amber-300">
            <Zap size={12} /> {progressData.xp} XP
          </span>
          <button 
            onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}
            className="p-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-600 text-white"
            aria-label="Toggle Menu"
          >
            {isMobileMenuOpen ? <X size={20} /> : <Menu size={20} />}
          </button>
        </div>
      </div>

      {/* SIDEBAR NAVIGATION (Desktop Fixed + Mobile Drawer) */}
      <aside className={`
        ${isMobileMenuOpen ? 'fixed inset-0 top-12 z-40 flex bg-black/50' : 'hidden'} 
        md:relative md:top-0 md:flex md:w-64 md:bg-transparent shrink-0
      `}>
        <div className="w-72 md:w-64 bg-white h-full border-r border-slate-200 flex flex-col justify-between shadow-xl md:shadow-none">
          <div>
            {/* Brand Header Desktop */}
            <div className="hidden md:flex p-5 border-b border-slate-100 items-center gap-3">
              <div className="bg-emerald-600 p-2.5 rounded-xl text-white shadow-sm">
                <GraduationCap size={22} />
              </div>
              <div>
                <h1 className="font-extrabold text-sm text-slate-900 tracking-tight leading-tight">University<br/>Exam Prep</h1>
                <span className="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded">NotebookLM Connected</span>
              </div>
            </div>

            {/* Active Course Selector */}
            {activeCourse && (
              <div className="p-3.5 bg-emerald-50/60 border-b border-emerald-100">
                <div className="flex justify-between items-center mb-1">
                  <label className="text-[10px] font-extrabold uppercase text-emerald-800 tracking-wider">Active Course</label>
                  <button onClick={() => handleNavigate('dashboard')} className="text-[10px] font-bold text-emerald-700 hover:underline">Switch</button>
                </div>
                <select
                  value={activeCourseId}
                  onChange={(e) => setActiveCourseId(e.target.value)}
                  className="w-full bg-white border border-emerald-200 rounded-lg px-2.5 py-2 text-xs font-bold text-slate-800 outline-none focus:border-emerald-600 shadow-sm"
                >
                  {courses.map(c => <option key={c.id} value={c.id}>{c.code}: {c.name}</option>)}
                </select>
              </div>
            )}

            {/* Navigation Links */}
            <nav className="p-3 space-y-1 overflow-y-auto max-h-[calc(100vh-230px)]">
              <NavItem icon={MapIcon} label="Study Roadmap (12 Sessions)" isActive={currentView === 'roadmap'} onClick={() => handleNavigate('roadmap')} />
              <NavItem icon={Play} label="Non-Repeat Quiz Engine" isActive={currentView === 'quiz'} onClick={() => handleNavigate('quiz', 'ALL')} badge={`${questions.filter(q => q.courseCode === activeCourse?.code).length} Qs`} />
              <NavItem icon={BookOpen} label="Bilingual Theory & Flashcards" isActive={currentView === 'theory'} onClick={() => handleNavigate('theory')} />
              <NavItem icon={UploadCloud} label="Document Library & Upload" isActive={currentView === 'documents'} onClick={() => handleNavigate('documents')} badge={`${activeCourse?.documents?.length || 0}`} />
              <NavItem icon={BarChart2} label="Exam Trend & Analytics" isActive={currentView === 'analytics'} onClick={() => handleNavigate('analytics')} />
              <NavItem icon={Bot} label="AI Study Assistant (VN)" isActive={currentView === 'ai'} onClick={() => handleNavigate('ai')} />
              <div className="pt-2 mt-2 border-t border-slate-100">
                <NavItem icon={Layers} label="All Courses & Settings" isActive={currentView === 'dashboard'} onClick={() => handleNavigate('dashboard')} />
              </div>
            </nav>
          </div>

          {/* Gamification Footer */}
          <div className="p-4 border-t border-slate-100 bg-slate-50 flex justify-between items-center text-xs font-bold text-slate-600">
            <div className="flex items-center gap-1.5 text-amber-600">
              <Flame size={16} fill="currentColor" /> {progressData.streak || 4} Day Streak
            </div>
            <div className="flex items-center gap-1.5 text-emerald-700">
              <Zap size={16} fill="currentColor" /> {progressData.xp || 350} XP
            </div>
          </div>
        </div>
        {/* Click outside backdrop for mobile */}
        <div className="flex-1 md:hidden" onClick={() => setIsMobileMenuOpen(false)} />
      </aside>

      {/* MAIN WORKSPACE CONTENT */}
      <main className="flex-1 flex flex-col min-w-0 overflow-hidden">
        {/* Desktop Course Context Bar */}
        {activeCourse && (
          <header className="hidden md:flex bg-white border-b border-slate-200 px-6 py-3.5 items-center justify-between shrink-0">
            <div className="min-w-0">
              <div className="flex items-center gap-2">
                <span className="bg-emerald-100 text-emerald-800 text-xs font-extrabold px-2 py-0.5 rounded">{activeCourse.code}</span>
                <h2 className="text-base font-extrabold text-slate-900 truncate">{activeCourse.name}</h2>
              </div>
              <p className="text-xs text-slate-500 font-semibold mt-0.5">{activeCourse.university} • {activeCourse.faculty}</p>
            </div>
            <div className="flex items-center gap-3 text-xs font-bold shrink-0">
              <span className="bg-slate-100 text-slate-700 px-3 py-1.5 rounded-lg flex items-center gap-1.5">
                <Target size={14} className="text-emerald-600" /> Goal: <strong className="text-emerald-700">{activeCourse.targetGrade}</strong>
              </span>
              <span className="bg-emerald-50 text-emerald-800 border border-emerald-200 px-3 py-1.5 rounded-lg flex items-center gap-1.5">
                <Calendar size={14} className="text-emerald-600" /> Exam: {activeCourse.examDate}
              </span>
            </div>
          </header>
        )}

        {/* Dynamic View Container */}
        <div className="flex-1 overflow-y-auto p-4 md:p-6">
          {currentView === 'roadmap' && (
            <RoadmapView 
              course={activeCourse} 
              questions={questions}
              progressData={progressData}
              onUpdateCourse={(updated) => setCourses(courses.map(c => c.id === updated.id ? updated : c))}
              onStartSessionQuiz={(sessionId) => handleNavigate('quiz', sessionId)}
              onOpenTheory={() => handleNavigate('theory')}
            />
          )}
          {currentView === 'documents' && (
            <DocumentLibraryView 
              course={activeCourse}
              onUpdateCourse={(updated) => setCourses(courses.map(c => c.id === updated.id ? updated : c))}
              onAddGeneratedQuestions={(newQs) => setQuestions(prev => [...prev, ...newQs])}
            />
          )}
          {currentView === 'theory' && (
            <TheoryReviewView course={activeCourse} />
          )}
          {currentView === 'quiz' && (
            <QuizEngineView 
              course={activeCourse}
              questions={questions}
              sessionFilter={selectedSessionFilter}
              setSessionFilter={setSelectedSessionFilter}
              progressData={progressData}
              updateProgress={updateProgress}
            />
          )}
          {currentView === 'analytics' && (
            <AnalyticsView 
              course={activeCourse} 
              questions={questions} 
              progressData={progressData} 
              onStartPractice={(sessionId) => handleNavigate('quiz', sessionId)}
            />
          )}
          {currentView === 'ai' && (
            <AiAssistantView course={activeCourse} />
          )}
          {currentView === 'dashboard' && (
            <CourseDashboardView 
              courses={courses} 
              activeCourseId={activeCourseId}
              onSelectCourse={(id) => { setActiveCourseId(id); handleNavigate('roadmap'); }}
              onAddCourse={(newCourse) => {
                setCourses(prev => [...prev, newCourse]);
                setActiveCourseId(newCourse.id);
                handleNavigate('roadmap');
              }}
              onDeleteCourse={(id) => {
                if (courses.length <= 1) return;
                const remaining = courses.filter(c => c.id !== id);
                setCourses(remaining);
                if (activeCourseId === id) setActiveCourseId(remaining[0].id);
              }}
            />
          )}
        </div>
      </main>
    </div>
  );
}

function NavItem({ icon: Icon, label, isActive, onClick, badge }) {
  return (
    <button
      onClick={onClick}
      className={`w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all ${
        isActive 
          ? 'bg-emerald-600 text-white shadow-sm' 
          : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'
