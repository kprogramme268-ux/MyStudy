              </div>
              <h3 className="text-base font-extrabold text-slate-900 mt-2">{c.name}</h3>
              <p className="text-xs text-slate-500 font-medium mt-0.5">{c.university} • Thi ngày: {c.examDate}</p>
              <p className="text-xs text-emerald-700 font-bold mt-3">{c.sessions?.length || 0} Sessions • {c.documents?.length || 0} Tài liệu</p>
            </div>
            <div className="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
              <button
                onClick={() => onSelectCourse(c.id)}
                className="bg-slate-900 hover:bg-emerald-600 text-white px-4 py-2 rounded-xl text-xs font-bold transition"
              >
                Mở lộ trình học
              </button>
              {courses.length > 1 && (
                <button
                  onClick={() => onDeleteCourse(c.id)}
                  className="p-2 text-slate-400 hover:text-red-600 rounded-lg"
                >
                  <Trash2 size={16} />
                </button>
              )}
            </div>
          </div>
        ))}
      </div>

      {showAddModal && (
        <div className="fixed inset-0 z-50 bg-black/60 flex items-center justify-center p-4">
          <form onSubmit={handleCreate} className="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-xl">
            <h3 className="text-base font-extrabold text-slate-900">Tạo Môn Học Mới</h3>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">Mã môn (Course Code)</label>
              <input required value={newCourse.code} onChange={e => setNewCourse({...newCourse, code: e.target.value})} className="w-full border border-slate-200 rounded-lg p-2 text-xs font-bold" />
            </div>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">Tên môn học</label>
              <input required value={newCourse.name} onChange={e => setNewCourse({...newCourse, name: e.target.value})} className="w-full border border-slate-200 rounded-lg p-2 text-xs font-bold" />
            </div>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">Ngày thi</label>
              <input type="date" required value={newCourse.examDate} onChange={e => setNewCourse({...newCourse, examDate: e.target.value})} className="w-full border border-slate-200 rounded-lg p-2 text-xs font-bold" />
            </div>
            <div className="flex justify-end gap-2 pt-2">
              <button type="button" onClick={() => setShowAddModal(false)} className="px-4 py-2 rounded-lg text-xs font-bold text-slate-600 bg-slate-100">Hủy</button>
              <button type="submit" className="px-4 py-2 rounded-lg text-xs font-bold text-white bg-emerald-600">Tạo môn học</button>
            </div>
          </form>
        </div>
      )}
    </div>
  );
}
